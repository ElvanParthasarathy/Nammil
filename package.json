{
  "name": "nammil",
  "productName": "Nammil",
  "author": "Elvan Parthasarathy <jaiprakashpartha@gmail.com> (https://jaiprakashpartha.vercel.app/)",
  "description": "A beautifully crafted, privacy-focused desktop companion for WhatsApp featuring multi-account sessions, automated media organization, and native notifications. By Elvan Navil.",
  "version": "1.2.9",
  "license": "MIT",
  "homepage": "https://elvannavil.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElvanParthasarathy/Nammil.git"
  },
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start:dev": "concurrently \"npm run dev\" \"npx wait-on http://localhost:5173 && npm run electron:dev\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --win",
    "build:pack": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false vite build && electron-builder --win --dir",
    "build:installer": "npm run build:pack && \"%LOCALAPPDATA%\\Programs\\Inno Setup 6\\ISCC.exe\" installer.iss",
    "release:publish": "node scripts/publish_release.cjs",
    "preview": "vite preview",
    "start": "electron ."
  },
  "build": {
    "appId": "com.nammil.app",
    "productName": "Nammil",
    "publish": {
      "provider": "github",
      "owner": "ElvanParthasarathy",
      "repo": "Nammil"
    },
    "directories": {
      "output": "build-release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "whatsapp_preload.cjs",
      "public/**/*",
      "package.json",
      "services/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nammil",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@material/web": "^2.5.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
